<?xml version="1.0" encoding="utf-8"?>
<!--
  CleanView — activity_main.xml  |  MVP Layout
  ═══════════════════════════════════════════════════════════════
  WCAG 2.1 Design Principles Applied:
  • 1.4.3 Contrast (Minimum): Yellow #FFFF00 on Black #000000 = 19.6:1 ✓ AAA
  • 2.5.5 Target Size: Voice button ≥ 48dp (we use 80dp circular target) ✓
  • 1.3.1 Info and Relationships: Semantic layout zones, screen-reader friendly

  LAYOUT ZONES:
  ┌──────────────────────────────────┐
  │  TOP BAR  (URL + status badge)   │  56dp fixed
  ├──────────────────────────────────┤
  │  VOICE ZONE  (mic button)        │  ~22% screen height
  ├──────────────────────────────────┤
  │  CONTENT FRAME                   │  remaining height
  │  ┌────────────────────────────┐  │
  │  │ WebView   (web mode)       │  │
  │  │ OR                         │  │
  │  │ RecyclerView (focus mode)  │  │
  │  └────────────────────────────┘  │
  │  ProgressBar (slim, top edge)    │
  └──────────────────────────────────┘
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ═══════════════════════════════════════════════════════════
         TOP BAR — URL strip + status badge
         Fixed 56dp. Black background, yellow accent line below.
    ═══════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#0D0D0D"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- CleanView wordmark -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CV"
            android:textColor="#FFFF00"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginEnd="10dp"
            android:importantForAccessibility="no"/>

        <!-- Domain display -->
        <TextView
            android:id="@+id/tvUrlBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="cleanview browser"
            android:textColor="#CCCCCC"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:ellipsize="end"
            android:importantForAccessibility="no"/>

        <!-- Status badge: shows "−4 ads · 6 headings" or "FOCUS MODE" -->
        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ready"
            android:textColor="#FFFF00"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/chip_bg"
            android:layout_marginStart="8dp"
            android:importantForAccessibility="no"/>
    </LinearLayout>

    <!-- Yellow accent line under top bar -->
    <View
        android:id="@+id/topBarLine"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:background="#FFFF00"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ═══════════════════════════════════════════════════════════
         VOICE ZONE — microphone button (~22% screen height)

         HCI: Fitts's Law — the single most important action
         (voice input) occupies the largest dedicated zone.
         The 80dp circular button gives a 2680mm² touch surface,
         vs 576mm² for a standard 48dp button.
    ═══════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/voiceZone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#000000"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/topBarLine"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.22">

        <ImageButton
            android:id="@+id/voiceSearchButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/mic_btn_bg"
            android:src="@android:drawable/ic_btn_speak_now"
            android:tint="#FFFF00"
            android:scaleType="fitCenter"
            android:padding="18dp"
            android:contentDescription="Voice Search. Tap to speak a website or search term. You can also shake the phone."
            android:focusable="true"
            android:clickable="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TAP OR SHAKE TO SEARCH"
            android:textColor="#FFFF00"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.15"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:importantForAccessibility="no"/>
    </LinearLayout>

    <!-- Yellow divider above content -->
    <View
        android:id="@+id/contentDivider"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:background="#FFFF00"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toBottomOf="@id/voiceZone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ═══════════════════════════════════════════════════════════
         CONTENT FRAME — WebView and FocusListView share this slot.
         Only one is visible at a time (GONE = zero layout space).

         HCI: Using GONE (not INVISIBLE) means the hidden view claims
         zero touch area — preventing phantom tap targets that could
         confuse TalkBack exploration mode.
    ═══════════════════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/contentFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/contentDivider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- WebView: standard browser rendering surface -->
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:visibility="visible"
            android:contentDescription="Web content"/>

        <!-- FocusListView: yellow-on-black semantic content list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/focusListView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:scrollbars="none"
            android:paddingTop="8dp"
            android:paddingBottom="32dp"
            android:clipToPadding="false"
            android:visibility="gone"
            android:contentDescription="Focus Mode. Semantic content list."/>

        <!-- Progress bar: slim strip along the top edge of content area.
             Driven by WebChromeClient.onProgressChanged (0–100). -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="top"
            style="?android:attr/progressBarStyleHorizontal"
            android:indeterminate="true"
            android:indeterminateTint="#FFFF00"
            android:visibility="gone"/>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
